flowchart LR
    Q["Question"] --> C["Policy chunks"]
    C --> R["Researcher<br/>Citation, or a miss"]
    R --> A["Analyst<br/>Uses only that citation"]
    A --> V{"Reviewer<br/>Is the citation real?"}
    V -->|yes| GO["Release the answer"]
    V -->|no| STOP["Do not release"]
    classDef blue fill:#1F6FEB,stroke:#0E2A43,color:#ffffff
    classDef navy fill:#10243E,stroke:#0E2A43,color:#ffffff
    classDef gold fill:#8A6A2F,stroke:#5C4718,color:#ffffff
    classDef green fill:#1F7A4D,stroke:#145536,color:#ffffff
    classDef red fill:#B42318,stroke:#7A1A12,color:#ffffff
    class Q,C navy
    class R blue
    class A gold
    class V navy
    class GO green
    class STOP red
