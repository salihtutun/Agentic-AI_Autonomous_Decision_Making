flowchart LR
    T["Ticket<br/>Language in"] --> M["Decide<br/>Name the next tool"]
    M --> TOOLS["Act<br/>Policy or order amount"]
    TOOLS --> MEM["Memory<br/>Store the tool result"]
    MEM -->|another tool| M
    MEM -->|finish| FIN["Refund, refuse,<br/>or escalate"]
    classDef navy fill:#10243E,stroke:#0E2A43,color:#ffffff
    classDef blue fill:#1F6FEB,stroke:#0E2A43,color:#ffffff
    classDef gold fill:#8A6A2F,stroke:#5C4718,color:#ffffff
    classDef red fill:#B42318,stroke:#7A1A12,color:#ffffff
    class T navy
    class M,TOOLS blue
    class MEM gold
    class FIN red
