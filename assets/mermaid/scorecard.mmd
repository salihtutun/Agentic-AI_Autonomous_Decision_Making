flowchart TB
    subgraph CARD["One scorecard for both families"]
        direction TB
        subgraph TASK["Task success"]
            direction LR
            T1["LLM: exceptions handled without a rewrite"]
            T2["RL: days the order matched the target"]
        end
        subgraph COST["Cost and latency"]
            direction LR
            C1["LLM: tool calls, often slower"]
            C2["RL: a fast policy"]
        end
        subgraph SAFE["Safety and grounding"]
            direction LR
            S1["LLM: the citation has to be real"]
            S2["RL: stay inside capacity and the veto"]
        end
        subgraph KPI["Business KPI"]
            direction LR
            K1["Same stockout number for both, against a baseline"]
        end
    end
    classDef llm fill:#1F6FEB,stroke:#0E2A43,color:#ffffff
    classDef rl fill:#B42318,stroke:#7A1A12,color:#ffffff
    classDef both fill:#1F7A4D,stroke:#145536,color:#ffffff
    class T1,C1,S1 llm
    class T2,C2,S2 rl
    class K1 both
    style CARD fill:#F7F9FC,stroke:#10243E,color:#10243E
    style TASK fill:#FFFFFF,stroke:#1F6FEB,color:#10243E
    style COST fill:#FFFFFF,stroke:#8A6A2F,color:#10243E
    style SAFE fill:#FFFFFF,stroke:#B42318,color:#10243E
    style KPI fill:#FFFFFF,stroke:#1F7A4D,color:#10243E
